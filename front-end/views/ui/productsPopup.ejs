<div
  id="productPopup"
  class="popup d-none position-fixed top-0 start-0 w-100 h-100 justify-content-center align-items-center"
>
  <form
    id="productForm"
    method="POST"
    class="d-flex flex-column bg-white p-4 rounded shadow w-25"
  >
    <div class="d-flex justify-content-end">
      <button
        type="button"
        id="closeProductPopup"
        class="btn-close"
        aria-label="Close"
      ></button>
    </div>
    <label id="productLabel" class="form-label fw-bold"></label>
    <div class="d-flex flex-column gap-2">
      <div class="d-flex flex-column">
        <label for="productName" class="form-label mb-0">Name</label>
        <input
          type="text"
          class="form-control"
          id="productName"
          name="name"
          placeholder="Enter name"
          required
        />
      </div>
      <div class="d-flex flex-column">
        <label for="productBrand" class="form-label mb-0">Brand</label>
        <select class="form-select" id="productBrand" name="brand" required>
          <% for (const brand of brands) { %>
            <option value="<%= brand.name %>"><%= brand.name %></option>
          <% } %>
        </select>
      </div>
      <div class="d-flex flex-column">
        <label for="productCategory" class="form-label mb-0">Category</label>
        <select class="form-select" id="productCategory" name="category" required>
          <% for (const category of categories) { %>
            <option value="<%= category.name %>"><%= category.name %></option>
          <% } %>
        </select>
      </div>
      <div class="d-flex flex-column">
        <label for="productDescription" class="form-label mb-0"
          >Description</label
        >
        <input
          type="text"
          class="form-control"
          id="productDescription"
          name="description"
          placeholder="Enter description"
          required
        />
      </div>
      <div class="d-flex flex-column">
        <label for="productQuantity" class="form-label mb-0">Quantity</label>
        <input
          type="number"
          class="form-control"
          id="productQuantity"
          name="quantity"
          min="0"
          placeholder="Enter quantity"
          required
        />
      </div>
      <div class="d-flex flex-column">
        <label for="productUnitprice" class="form-label mb-0">Price</label>
        <input
          type="number"
          class="form-control"
          id="productUnitprice"
          name="unitprice"
          min="0.1"
          step="0.01"
          placeholder="Enter price"
          required
        />
      </div>
      <div class="d-flex flex-column">
        <label for="productImgurl" class="form-label mb-0">Image</label>
        <input
          type="text"
          class="form-control"
          id="productImgurl"
          name="imgurl"
          placeholder="Enter image url"
          required
        />
      </div>
    </div>

    <div id="productDeletedWrapper" class="form-check form-switch mt-3">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="productIsdeleted"
        name="isdeleted"
      />
      <label for="productIsdeleted" class="form-check-label">Is deleted</label>
    </div>
    <button
      id="productSubmit"
      type="submit"
      class="btn btn-success text-white mt-3"
    >
      <span id="productSubmitIcon"
        ><i class="fa-solid fa-pen-to-square"></i
      ></span>

      <span id="productSubmitText">Save changes</span>
    </button>
  </form>
</div>
