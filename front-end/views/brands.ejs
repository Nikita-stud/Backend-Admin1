<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EP - Brands</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/54f19440a6.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('partials/header') %>
    <main class="flex-grow-1">
      <div class="container-fluid px-5 py-4">
        <h1 class="fw-bold">Brands</h1>
        <h2 class="text-muted">Manage brands</h2>
        <div class="d-flex justify-content-end mt-3">
          <form
            action="/admin/brands/add"
            method="POST"
          >
            <div class="input-group">
              <input
                type="text"
                class="form-control"
                name="name"
                placeholder="Enter brand name"
                required
              />
              <button
                type="submit"
                class="btn btn-success text-white"
              >
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
      <div class="container-fluid px-5 mb-5">
        <% if(error) { %>
          <div class="d-flex justify-content-center align-items-center text-white bg-danger my-5 mx-auto w-50 fw-bold border border-dark p-3">
              <%= error %>
          </div>
        <% } %>
        <table
          id="brandsTable"
          class="table table-sm table-striped table-hover table-bordered mx-auto w-50 text-center align-middle"
        >
          <thead class="small">
            <tr>
              <th scope="col">Id</th>
              <th scope="col">Name</th>
              <th scope="col">Options</th>
            </tr>
          </thead>
          <tbody class="small">
            <% for (const brand of brands) { %>
              <tr>
                <td><%= brand.id %></td>
                <td><%= brand.name %></td>
                <td>
                  <div class="d-flex flex-column gap-1">
                    <form
                      action="/admin/brands/delete/<%= brand.id %>"
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete brand: <%= brand.name %>?')"
                    >
                      <button
                        type="submit"
                        class="btn btn-sm btn-danger text-white w-100"
                      >
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                      <button value="<%= brand.id %>" class="editBrandCta btn btn-sm btn-warning text-white w-100">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
    <%- include('ui/brandsPopup') %>
    <%- include('partials/footer') %>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/handlers/brandsPopup.mjs"></script>  </body>
</html>
