<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EP - Users</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/54f19440a6.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('partials/header') %>
    <main class="flex-grow-1">
      <div class="container-fluid px-5 py-4">
        <h1 class="fw-bold">Users</h1>
        <h2 class="text-muted">Manage users</h2>
      </div>
      <div class="container-fluid px-5 mb-5">
        <table
          id="usersTable"
          class="table table-sm table-striped table-hover table-bordered mx-auto w-auto text-center align-middle"
        >
          <thead class="small">
            <tr>
              <th scope="col">Id</th>
              <th scope="col">Username</th>
              <th scope="col">First name</th>
              <th scope="col">Last name</th>
              <th scope="col">Email</th>
              <th scope="col">Address</th>
              <th scope="col">City</th>
              <th scope="col">Phone</th>
              <th scope="col">Role</th>
              <th scope="col">Membership</th>
              <th scope="col">Options</th>
            </tr>
          </thead>
          <tbody class="small">
            <% for (const user of users) { %>
              <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.firstName %></td>
                <td><%= user.lastName %></td>
                <td><%= user.email %></td>
                <td><%= user.address %></td>
                <td>
                  <% if(user.city) { %>
                    <%= user.city %>
                  <% } else { %>
                    <i class="fa-solid fa-minus"></i>
                  <% } %>
                </td>
                <td><%= user.phone %></td>
                <td><%= user.role_id === 1 ? 'Admin' : 'User' %></td>
                <td>
                  <% if(user.role_id === 1) { %>
                    <i class="fa-solid fa-minus"></i>
                  <% } else { %>
                    <%= memberships.find(membership => membership.id === user.membership_id)?.name %>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex flex-column gap-1">
                    <% if(user.role_id !== 1) { %>
                    <form
                      action="/admin/users/delete/<%= user.id %>"
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete user: <%= user.username %>?')"
                    >
                      <button
                        type="submit"
                        class="btn btn-sm btn-danger text-white w-100"
                      >
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                    <form
                      action="/admin/users/update/<%= user.id %>"
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to make user: <%= user.username %> an admin?')"
                    >
                      <input type="hidden" name="role_id" value="1">
                      <button
                        type="submit"
                        class="btn btn-sm btn-warning text-white w-100"
                      >
                        <i class="fa-solid fa-user-secret"></i>
                      </button>
                    </form>
                    <% } else { %>
                      <i class="fa-solid fa-minus"></i>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <% if(error) { %>
          <div class="container d-flex justify-content-center align-items-center text-white bg-danger mt-5 fw-bold  border border-dark  p-5">
              <%= error %>
          </div>
        <% } %>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
