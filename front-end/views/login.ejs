<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EP - Login</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/54f19440a6.js"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <main>
      <div class="d-flex flex-row vh-100">
        <div class="image-container col-8 h-100">
          <img src="/images/water.jpg" alt="Water image" class="w-100 h-100" />
        </div>
        <div class="col-4 px-4 m-auto pt-5">
          <h1>
            <i class="fa-solid fa-square text-danger"></i>
            <span class="fw-bold">EP</span>Admin
          </h1>
          <p>Please login as an administrator</p>
          <% if (error) { %>
            <div class="alert alert-danger text-center" role="alert">
              <%= error %>
            </div>
          <% } %>
          <div>
            <form
              action="/login"
              method="post"
              class="d-flex flex-column gap-3"
            >
              <div class="d-flex flex-column">
                <label for="username" class="form-label text-muted"
                  >Email Address / Username</label
                >
                <input
                  class="form-control"
                  id="username"
                  name="username"
                  type="text"
                  autocomplete="username"
                  required
                  autofocus
                  placeholder="Enter email or username"
                />
              </div>
              <div class="d-flex flex-column">
                <label for="current-password" class="form-label text-muted"
                  >Password</label
                >
                <input
                  class="form-control"
                  id="current-password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  placeholder="Enter password"
                />
              </div>
              <button type="submit" class="btn btn-primary mt-3 py-3 fw-bold">
                Sign me in
              </button>
            </form>
          </div>
          <div class="mt-5">
            <hr />
            <p class="text-center text-muted">
              <i class="fa-regular fa-copyright"></i> 2026 EPAdmin. All rights
              reserved.
            </p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
