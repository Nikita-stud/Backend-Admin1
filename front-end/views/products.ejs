<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EP - Products</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/54f19440a6.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('partials/header') %>
    <main class="flex-grow-1">
      <div class="container-fluid px-5 py-4">
        <h1 class="fw-bold">Products</h1>
        <h2 class="text-muted">Manage products</h2>
      </div>
      <div class="container-fluid px-5 mb-5">
        <div class="d-flex justify-content-between gap-3 align-items-start">
          <%- include('partials/search') %>
          <button type="button" class="addProductCta btn btn-success text-white text-nowrap">
            <i class="fa-solid fa-plus"></i> Add
          </button>
        </div>
        <table
          id="productsTable"
          class="table table-sm table-striped table-hover table-bordered mx-auto w-auto text-center align-middle"
        >
          <thead class="small">
            <tr>
              <th scope="col">Id</th>
              <th scope="col">Name</th>
              <th scope="col">Description</th>
              <th scope="col">Quantity</th>
              <th scope="col">Price</th>
              <th scope="col">Discount</th>
              <th scope="col">Brand</th>
              <th scope="col">Category</th>
              <th scope="col">Image URL</th>
              <th scope="col">Image</th>
              <th scope="col">isDeleted</th>
              <th scope="col">Date_added</th>
              <th scope="col">Options</th>
            </tr>
          </thead>
            <tbody class="small">
              <% for (const product of products) { %>
                <tr>
                  <td><%= product.id %></td>
                    <td><%= product.name %></td>
                <td><%= product.description %></td>
                <td><%= product.quantity %></td>
                <td><%= product.unitprice %></td>
                <td>0</td>
                <td><%= product.brand %></td>
                <td><%= product.category %></td>
                <td><%= product.imgurl %></td>
                <td>
                  <img
                    src="<%= product.imgurl %>"
                    alt="<%= product.name %>"
                    onerror="this.onerror=null; this.src='/images/no-photo.svg'"
                    class="product-img"
                  />
                </td>
                <td><%= product.isdeleted ? 'Yes' : 'No' %></td>
                <td><%= product.date_added %></td>
                <td>
                  <div class="d-flex flex-column gap-1">
                    <% if(!product.isdeleted) { %>
                    <form
                      action="/admin/products/delete/<%= product.id %>"
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete product: <%= product.name %>?')"
                    >
                      <button
                        type="submit"
                        class="btn btn-sm btn-danger text-white w-100"
                      >
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                    <% } %>
                      <button
                        value="<%= product.id %>"
                        data-name="<%= product.name %>"
                        data-brand="<%= product.brand %>"
                        data-category="<%= product.category %>"
                        data-description="<%= product.description %>"
                        data-quantity="<%= product.quantity %>"
                        data-unitprice="<%= product.unitprice %>"
                        data-imgurl="<%= product.imgurl %>"
                        data-isdeleted="<%= product.isdeleted ? 'true' : 'false' %>"
                        class="editProductCta btn btn-sm btn-warning text-white w-100"
                      >
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <% if(error) { %>
          <div class="container d-flex justify-content-center align-items-center text-white bg-danger mt-5 fw-bold  border border-dark  p-5">
              <%= error %>
          </div>
        <% } %>
      </div>
    </main>
    <%- include('ui/productsPopup') %>
    <%- include('partials/footer') %>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/handlers/productsPopup.mjs"></script>  
  </body>
</html>
