<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EP - Memberships</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/54f19440a6.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include('partials/header') %>
    <main class="flex-grow-1">
      <div class="container-fluid px-5 py-4">
        <h1 class="fw-bold">Memberships</h1>
        <h2 class="text-muted">Manage memberships</h2>
        <div class="d-flex justify-content-end mt-3">
        </div>
      </div>
      <div class="container-fluid px-5 mb-5">
        <% if(error) { %>
          <div class="d-flex justify-content-center align-items-center text-white bg-danger my-5 mx-auto w-50 fw-bold border border-dark p-3">
              <%= error %>
          </div>
        <% } %>
        <table
          id="membershipsTable"
          class="table table-sm table-striped table-hover table-bordered mx-auto w-50 text-center align-middle"
        >
          <thead class="small">
            <tr>
              <th scope="col">Id</th>
              <th scope="col">Name</th>
              <th scope="col">Discount</th>
              <th scope="col">Min Items</th>
              <th scope="col">Max Items</th>
              <th scope="col">Options</th>
            </tr>
          </thead>
          <tbody class="small">
            <% for (const membership of memberships) { %>
              <tr>
                <td><%= membership.id %></td>
                <td><%= membership.name %></td>
                <td><%= membership.discount %></td>
                <td><%= membership.minItems %></td>
                <td>
                  <% if(membership.maxItems) { %>
                    <%= membership.maxItems %>
                  <% } else { %>
                    <i class="fa-solid fa-minus"></i>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex flex-column gap-1">
                      <button value="<%= membership.id %>" class="editMembershipCta btn btn-sm btn-warning text-white w-100">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
    <%- include('ui/membershipPopup') %>
    <%- include('partials/footer') %>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/handlers/membershipPopup.mjs"></script>  </body></html>
